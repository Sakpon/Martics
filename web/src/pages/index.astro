---
import Base from '../layouts/Base.astro';
---

<Base title="Martics — Community for creators on LINE">
  <main class="mx-auto max-w-2xl px-6 py-20">
    <h1 class="text-4xl font-bold tracking-tight">Martics</h1>
    <p class="mt-4 text-lg text-slate-600">
      A LINE-native community platform that lets creators engage their members across
      levels — announcements, exclusive content, and segmented broadcasts, all inside LINE.
    </p>

    <ul class="mt-10 space-y-3 text-slate-700">
      <li>• Members organized into creator-defined tiers</li>
      <li>• Level-gated content &amp; targeted broadcasts</li>
      <li>• Engagement tracking and win-back automation</li>
      <li>• Built on Cloudflare Workers + D1 + KV</li>
    </ul>

    <div class="mt-10 flex gap-4 text-sm">
      <a href="/privacy" class="text-emerald-600 underline">Privacy</a>
      <a href="/terms" class="text-emerald-600 underline">Terms</a>
    </div>
  </main>
</Base>
