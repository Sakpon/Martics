---
import Admin from '../../layouts/Admin.astro';

const db = Astro.locals.runtime.env.DB;
const q = Astro.url.searchParams.get('q') ?? '';

const { results } = q
  ? await db
      .prepare(
        `SELECT m.id, m.display_name, m.engagement_score, m.last_seen_at, l.name AS level
         FROM members m LEFT JOIN levels l ON l.id = m.level_id
         WHERE m.status='active' AND m.display_name LIKE ?
         ORDER BY m.engagement_score DESC LIMIT 100`,
      )
      .bind(`%${q}%`)
      .all()
  : await db
      .prepare(
        `SELECT m.id, m.display_name, m.engagement_score, m.last_seen_at, l.name AS level
         FROM members m LEFT JOIN levels l ON l.id = m.level_id
         WHERE m.status='active'
         ORDER BY m.engagement_score DESC LIMIT 100`,
      )
      .all();
---

<Admin title="Members — Martics Admin">
  <h1 class="text-2xl font-bold">Members</h1>

  <form method="get" class="mt-4">
    <input
      name="q"
      value={q}
      placeholder="Search by name…"
      class="rounded border px-3 py-2 text-sm"
    />
  </form>

  <table class="mt-6 w-full text-sm">
    <thead class="text-left text-slate-500">
      <tr><th class="py-2">Name</th><th>Level</th><th>Score</th><th>Last seen</th><th></th></tr>
    </thead>
    <tbody>
      {(results ?? []).map((m: any) => (
        <tr class="border-t">
          <td class="py-2">{m.display_name ?? '(unknown)'}</td>
          <td>{m.level ?? '—'}</td>
          <td class="font-mono">{m.engagement_score}</td>
          <td class="text-slate-500">{m.last_seen_at ?? '—'}</td>
          <td><a class="text-emerald-600 underline" href={`/members/${m.id}`}>manage</a></td>
        </tr>
      ))}
    </tbody>
  </table>
</Admin>
