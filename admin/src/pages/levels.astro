---
import Admin from '../layouts/Admin.astro';

const db = Astro.locals.runtime.env.DB;
let message = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  await db
    .prepare(
      `INSERT INTO levels (influencer_id, name, rank, color, perks, is_default)
       VALUES (1, ?, ?, ?, ?, 0)`,
    )
    .bind(
      String(form.get('name')),
      Number(form.get('rank') ?? 0),
      String(form.get('color') ?? ''),
      String(form.get('perks') ?? ''),
    )
    .run();
  message = 'Level created.';
}

const { results } = await db.prepare(`SELECT * FROM levels ORDER BY rank`).all<any>();
---

<Admin title="Levels — Martics Admin">
  <h1 class="text-2xl font-bold">Levels</h1>
  {message && <p class="mt-3 rounded bg-emerald-100 px-3 py-2 text-sm text-emerald-800">{message}</p>}

  <table class="mt-6 w-full max-w-2xl text-sm">
    <thead class="text-left text-slate-500"><tr><th>Rank</th><th>Name</th><th>Color</th><th>Perks</th><th>Default</th></tr></thead>
    <tbody>
      {(results ?? []).map((l: any) => (
        <tr class="border-t">
          <td class="py-2">{l.rank}</td>
          <td>{l.name}</td>
          <td><span class="inline-block h-3 w-3 rounded-full" style={`background:${l.color}`}></span> {l.color}</td>
          <td>{l.perks}</td>
          <td>{l.is_default ? '✓' : ''}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2 class="mt-10 text-lg font-semibold">Add level</h2>
  <form method="post" class="mt-3 grid max-w-sm gap-3">
    <input name="name" placeholder="Name" required class="rounded border px-3 py-2" />
    <input name="rank" type="number" placeholder="Rank (0 = lowest)" class="rounded border px-3 py-2" />
    <input name="color" placeholder="#FFD700" class="rounded border px-3 py-2" />
    <input name="perks" placeholder="Perks description" class="rounded border px-3 py-2" />
    <button class="rounded bg-emerald-600 px-4 py-2 text-white">Create</button>
  </form>
</Admin>
